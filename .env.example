# Local development: copy the server values to .dev.vars (read by `npm run dev:api`, wrangler).
# Production: set them in Cloudflare Pages -> Settings -> Variables and Secrets.
YOUTUBE_API_KEY=your-youtube-api-key-here
# Set to 1 to test the "daily limit reached" notice
# SIMULATE_QUOTA=1

# Build-time value (.env.local or the Pages build settings): public origin shown in the
# CORS setup commands for Ollama / ComfyUI. The page uses its own origin when it differs.
NEXT_PUBLIC_SITE_ORIGIN=https://ts.dgdev.cl
